# Port exposed by the container (7860 matches Hugging Face Spaces default)
PORT=7860

# Comma-separated frontend origins allowed by CORS (use * for open testing)
# Example: CORS_ORIGINS=https://nakespro.com,https://app.nakespro.com
CORS_ORIGINS=*

# Optional API key required in X-API-Key header for POST /predict (leave empty to disable)
API_KEY=

# Path inside container to ONNX model
MODEL_PATH=/app/models/woundvision_v5_augmented.onnx

# Optional: Direct download URL if model is not bundled in /app/models
MODEL_URL=
MODEL_AUTH_TOKEN=

# CPU threading tuned for 2-vCPU Hugging Face Spaces / shared VPS
ORT_INTRA_THREADS=2
ORT_INTER_THREADS=1
