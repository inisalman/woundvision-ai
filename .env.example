# Port exposed by the container
PORT=7860

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=https://salmanalfarisi.id,https://www.salmanalfarisi.id

# Optional API key required in X-API-Key header for POST /predict
API_KEY=

# V6 Two-Stage ONNX model paths & auto-download URLs (defaults to Hugging Face salmanid/woundvision-ai)
STAGE1_MODEL_PATH=/app/models/woundvision_v6_stage1_wound.onnx
STAGE2_MODEL_PATH=/app/models/woundvision_v6_stage2_tissue.onnx
STAGE1_MODEL_URL=https://huggingface.co/salmanid/woundvision-ai/resolve/main/woundvision_v6_stage1_wound.onnx
STAGE2_MODEL_URL=https://huggingface.co/salmanid/woundvision-ai/resolve/main/woundvision_v6_stage2_tissue.onnx
MODEL_AUTH_TOKEN=

# CPU threading tuned for shared VPS
ORT_INTRA_THREADS=2
ORT_INTER_THREADS=1
